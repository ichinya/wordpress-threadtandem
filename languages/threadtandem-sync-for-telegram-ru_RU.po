#. Plugin Name of the plugin
#: threadtandem-sync-for-telegram.php
msgid "ThreadTandem — Post Publishing and Comment Sync for Telegram"
msgstr "ThreadTandem — публикация записей и синхронизация комментариев с Telegram"

#. Description of the plugin
#: threadtandem-sync-for-telegram.php
msgid "Publish posts to Telegram and synchronize text comments with a linked discussion group."
msgstr "Публикация записей в Telegram и синхронизация текстовых комментариев со связанной группой обсуждений."

#. Author of the plugin
#: threadtandem-sync-for-telegram.php
msgid "Ichi-nya"
msgstr "Ichi-nya"

#: includes/admin-view.php:15
msgid "Publishing and comments in Telegram."
msgstr "Публикация записей и синхронизация комментариев с Telegram."

#: includes/admin-view.php:16 includes/admin-view.php:136
msgid "Queue and diagnostics"
msgstr "Очередь и диагностика"

#: includes/admin-view.php:28
msgid "Connect Telegram"
msgstr "Подключение Telegram"

#: includes/admin-view.php:29
msgid "One bot, one channel and its discussion group."
msgstr "Подключите бота, канал и связанную с ним группу обсуждений."

#: includes/admin-view.php:33
msgid "Bot token"
msgstr "Токен бота"

#: includes/admin-view.php:37
msgid "Saved"
msgstr "Сохранён"

#: includes/admin-view.php:39
msgid "Configured on the server with TREDA_BOT_TOKEN."
msgstr "Задан на сервере константой TREDA_BOT_TOKEN."

#: includes/admin-view.php:41
msgid "Leave blank to keep the saved token"
msgstr "Оставьте пустым, чтобы сохранить токен"

#: includes/admin-view.php:41
msgid "Paste the token from BotFather"
msgstr "Вставьте токен из BotFather"

#: includes/admin-view.php:42 includes/class-treda-admin.php:59
msgid "Show"
msgstr "Показать"

#: includes/admin-view.php:43
msgid "Create a dedicated bot with @BotFather and paste its token."
msgstr "Создайте отдельного бота через @BotFather и вставьте его токен."

#: includes/admin-view.php:47
msgid "Remove the saved token"
msgstr "Удалить сохранённый токен"

#: includes/admin-view.php:50 includes/admin-view.php:103
#: includes/class-treda-bulk.php:82
msgid "Telegram channel"
msgstr "Канал Telegram"

#: includes/admin-view.php:52
msgid "Use an @username, a t.me link or a channel ID. The linked group is detected automatically."
msgstr "Укажите @username, ссылку t.me или ID канала. Группа обсуждений определится автоматически."

#: includes/admin-view.php:59
msgid "What to synchronize"
msgstr "Что синхронизировать"

#: includes/admin-view.php:59
msgid "Choose how WordPress and Telegram work together."
msgstr "Выберите, что передавать между сайтом и Telegram."

#: includes/admin-view.php:61
msgid "Post publishing"
msgstr "Отправка записей в Telegram"

#: includes/admin-view.php:62
msgid "Send public posts to your channel and update their announcements when you edit them."
msgstr "Отправлять опубликованные записи в канал и обновлять анонсы при изменении записей на сайте."

#: includes/admin-view.php:66
msgid "Article link text"
msgstr "Текст ссылки на статью"

#: includes/admin-view.php:68
msgid "Text below the Telegram announcement that links to the article. Leave blank for the default in the site language. Maximum 100 characters."
msgstr "Подпись ссылки на статью под анонсом в Telegram. Оставьте поле пустым, чтобы использовать значение по умолчанию для языка сайта. Не более 100 символов."

#: includes/admin-view.php:69
msgid "Applies to new announcements and queued updates. To update an existing announcement, use Send on the Post synchronization page."
msgstr "Применяется к новым анонсам и обновлениям через очередь. Чтобы изменить существующий анонс, нажмите «Отправить» на странице синхронизации записей."

#: includes/admin-view.php:71
msgid "Import channel posts as drafts"
msgstr "Импорт записей из Telegram в черновики"

#: includes/admin-view.php:72
msgid "Receive new Telegram posts and edits. Review drafts and link existing articles on the Post synchronization page."
msgstr "Сохранять новые записи канала и изменения в черновиках. Проверяйте их и привязывайте к записям сайта на вкладке «Синхронизация записей»."

#: includes/admin-view.php:75
msgid "Comment synchronization"
msgstr "Синхронизация комментариев"

#: includes/admin-view.php:76
msgid "Keep text replies in one conversation, whether they are written on the website or in Telegram."
msgstr "Синхронизировать текстовые комментарии между сайтом и обсуждением в Telegram."

#: includes/admin-view.php:79
msgid "Hold new Telegram comments for moderation"
msgstr "Проверять новые комментарии из Telegram перед публикацией"

#: includes/admin-view.php:80
msgid "Website comments are sent after approval. Edited Telegram messages return to moderation."
msgstr "Комментарии сайта отправляются в Telegram после одобрения. Изменённые сообщения из Telegram снова поступают на проверку."

#: includes/admin-view.php:81
msgid "Inform group members that their messages may also appear on your website."
msgstr "Сообщите участникам группы, что их сообщения также могут появиться на сайте."

#: includes/admin-view.php:85
msgid "This site requires registered commenters. Telegram-only authors cannot be imported while that setting is enabled."
msgstr "На сайте разрешены комментарии только зарегистрированных пользователей. Пока включена эта настройка, комментарии из Telegram не импортируются."

#: includes/admin-view.php:89
msgid "Advanced settings"
msgstr "Дополнительные настройки"

#: includes/admin-view.php:89
msgid "API server, external address and uninstall options"
msgstr "Сервер API, внешний адрес и сохранение данных"

#: includes/admin-view.php:91
msgid "Telegram API server"
msgstr "Сервер Telegram API"

#: includes/admin-view.php:91
msgid "An HTTPS Bot API server or compatible proxy. Used for all requests. WordPress may reject private addresses and nonstandard ports."
msgstr "HTTPS-сервер Bot API или совместимый прокси. Используется для всех запросов. WordPress может отклонять частные адреса и нестандартные порты."

#: includes/admin-view.php:92
msgid "External webhook URL"
msgstr "Внешний адрес вебхука"

#: includes/admin-view.php:92
msgid "Optional public HTTPS address forwarding to the REST endpoint. Preserve the request body and secret header. A .local hostname cannot receive Telegram webhooks."
msgstr "Необязательный публичный HTTPS-адрес, который перенаправляет запросы в REST API сайта, сохраняя тело запроса и секретный заголовок. Адрес с доменом .local не может принимать вебхуки Telegram."

#: includes/admin-view.php:93
msgid "Keep integration data when deleting the plugin"
msgstr "Сохранять данные интеграции при удалении плагина"

#: includes/admin-view.php:93
msgid "If cleared, uninstall removes ThreadTandem settings, mappings and queue tables. Posts and comments remain. Disconnect the webhook before deleting the plugin."
msgstr "Если снять флажок, при удалении плагина будут удалены его настройки, связи с Telegram и таблицы очереди. Записи и комментарии сохранятся. Перед удалением плагина отключите вебхук."

#: includes/admin-view.php:98 includes/admin-view.php:100
msgid "Connection status"
msgstr "Состояние подключения"

#: includes/admin-view.php:100
msgid "Verified"
msgstr "Проверено"

#: includes/admin-view.php:100
msgid "Not verified"
msgstr "Не проверено"

#: includes/admin-view.php:103
msgid "Discussion group ID:"
msgstr "ID группы обсуждений:"

#: includes/admin-view.php:103
msgid "Not linked"
msgstr "Не подключена"

#: includes/admin-view.php:107
msgid "Last checked:"
msgstr "Последняя проверка:"

#: includes/admin-view.php:109
msgid "Save your bot and channel, then check their permissions."
msgstr "Сохраните токен и канал, затем проверьте права бота."

#: includes/admin-view.php:111
msgid "Check connection"
msgstr "Проверить подключение"

#: includes/admin-view.php:112
msgid "Save changes before checking the connection."
msgstr "Перед проверкой сохраните изменения настроек."

#: includes/admin-view.php:115
msgid "Telegram events"
msgstr "Приём событий Telegram"

#: includes/admin-view.php:116
msgid "Enable incoming events so Telegram replies can reach your website."
msgstr "Подключите вебхук, чтобы получать на сайте записи и комментарии из Telegram."

#: includes/admin-view.php:120
msgid "A public HTTPS address is needed to receive events. Set it in Advanced settings when testing locally."
msgstr "Для приёма событий нужен публичный HTTPS-адрес. При локальном тестировании задайте его в дополнительных настройках."

#: includes/admin-view.php:121
msgid "Connect events"
msgstr "Подключить вебхук"

#: includes/admin-view.php:121
msgid "Disconnect"
msgstr "Отключить вебхук"

#: includes/admin-view.php:122
msgid "Receive pending events"
msgstr "Получить накопленные события"

#: includes/admin-view.php:123
msgid "Use after a delivery outage. Receives up to 100 pending events, then restores the webhook. Telegram retains events for up to 24 hours."
msgstr "Используйте после сбоя доставки. Получает до 100 накопленных событий, затем восстанавливает вебхук. Telegram хранит события не более 24 часов."

#: includes/admin-view.php:124
msgid "Webhook endpoint:"
msgstr "Адрес вебхука:"

#: includes/admin-view.php:124
msgid "Copy"
msgstr "Копировать"

#: includes/admin-view.php:127
msgid "Before connecting"
msgstr "Перед подключением"

#: includes/admin-view.php:127
msgid "Create a dedicated bot in BotFather."
msgstr "Создайте отдельного бота в BotFather."

#: includes/admin-view.php:127
msgid "Make the bot a channel administrator with permission to publish."
msgstr "Назначьте бота администратором канала с правом публикации."

#: includes/admin-view.php:127
msgid "Link a discussion group and add the bot as its administrator."
msgstr "Привяжите группу обсуждений и добавьте в неё бота администратором."

#: includes/admin-view.php:136
msgid "Delivery history and jobs that need attention"
msgstr "История доставки и задания, требующие внимания"

#: includes/admin-view.php:136
msgid "Needs attention"
msgstr "Требуют внимания"

#: includes/admin-view.php:136
msgid "In progress"
msgstr "В обработке"

#: includes/admin-view.php:137 includes/admin-view.php:144
msgid "Queued"
msgstr "В очереди"

#: includes/admin-view.php:137 includes/admin-view.php:147
msgid "Failed"
msgstr "Ошибка"

#: includes/admin-view.php:137 includes/admin-view.php:148
msgid "Result unknown"
msgstr "Результат неизвестен"

#: includes/admin-view.php:137
msgid "Process queue now"
msgstr "Обработать очередь сейчас"

#: includes/admin-view.php:139
msgid "The queue is empty."
msgstr "Очередь пуста."

#: includes/admin-view.php:139
msgid "Publish a post or approve a comment to see its delivery here."
msgstr "После публикации записи или одобрения комментария здесь появится результат отправки."

#: includes/admin-view.php:141
msgid "Recent delivery jobs"
msgstr "Последние задания доставки"

#: includes/admin-view.php:141
msgid "Job"
msgstr "Задание"

#: includes/admin-view.php:141
msgid "Status"
msgstr "Состояние"

#: includes/admin-view.php:141
msgid "Attempts"
msgstr "Число попыток"

#: includes/admin-view.php:141
msgid "Message"
msgstr "Сообщение"

#: includes/admin-view.php:141
msgid "Action"
msgstr "Действие"

#: includes/admin-view.php:145
msgid "Running"
msgstr "Выполняется"

#: includes/admin-view.php:146
msgid "Done"
msgstr "Готово"

#: includes/admin-view.php:160
msgid "I checked Telegram and accept the risk of a duplicate."
msgstr "Я проверил Telegram и принимаю риск появления дубликата."

#: includes/admin-view.php:160
msgid "Retry"
msgstr "Повторить"

#: includes/admin-view.php:164
msgid "WP-Cron processes small batches. Low-traffic sites may need a system cron. An uncertain result requires checking Telegram before retrying."
msgstr "WP-Cron обрабатывает очередь небольшими порциями. Если сайт редко посещают, настройте запуск cron на сервере. Если результат отправки неизвестен, перед повторной попыткой проверьте Telegram."

#: includes/admin-view.php:167
msgid "Settings changes"
msgstr "Изменения настроек"

#: includes/admin-view.php:167
msgid "Changes take effect after you save the settings."
msgstr "Настройки применятся после сохранения."

#: includes/admin-view.php:167
msgid "Save settings"
msgstr "Сохранить настройки"

#: includes/class-treda-admin.php:36
msgid "Settings and queue"
msgstr "Настройки и очередь"

#: includes/class-treda-admin.php:37
msgid "Post synchronization"
msgstr "Синхронизация записей"

#: includes/class-treda-admin.php:60
msgid "Hide"
msgstr "Скрыть"

#: includes/class-treda-admin.php:61
msgid "Copied"
msgstr "Скопировано"

#: includes/class-treda-admin.php:62
msgid "Address selected. Copy it with your keyboard."
msgstr "Адрес выделен. Скопируйте его с помощью клавиатуры."

#: includes/class-treda-admin.php:63
msgid "You have unsaved changes. Save them before checking the connection."
msgstr "Есть несохранённые изменения. Сохраните их перед проверкой подключения."

#: includes/class-treda-admin.php:70
msgid "You do not have permission to manage ThreadTandem."
msgstr "У вас нет прав на управление ThreadTandem."

#: includes/class-treda-admin.php:78
msgid "Bot permissions checked. Webhook delivery still needs a real incoming event."
msgstr "Права бота проверены. Чтобы проверить доставку через вебхук, отправьте запись или комментарий в Telegram."

#: includes/class-treda-admin.php:81
msgid "Webhook registered. Check incoming events in the queue."
msgstr "Вебхук подключён. Входящие события можно проверить в очереди."

#: includes/class-treda-admin.php:84
msgid "The ThreadTandem webhook is disconnected."
msgstr "Вебхук ThreadTandem отключён."

#: includes/class-treda-admin.php:87
msgid "Pending Telegram events were received and the webhook was restored. Process the queue to import them."
msgstr "Накопленные события Telegram получены, вебхук восстановлен. Для импорта обработайте очередь."

#: includes/class-treda-admin.php:90
msgid "A queue batch was processed. See the results below."
msgstr "Обработана очередная порция заданий. Результаты показаны ниже."

#: includes/class-treda-admin.php:94
msgid "The job was queued again."
msgstr "Задание возвращено в очередь."

#: includes/class-treda-admin.php:95
msgid "The job was not changed. Confirm a Telegram check before retrying an uncertain result."
msgstr "Задание не изменено. Для повтора с неизвестным результатом подтвердите проверку Telegram."

#: includes/class-treda-admin.php:97
msgid "Unknown action."
msgstr "Неизвестное действие."

#: includes/class-treda-api.php:10
msgid "Save the bot token first."
msgstr "Сначала сохраните токен бота."

#: includes/class-treda-api.php:41
msgid "The send result is unknown. Check Telegram before retrying."
msgstr "Результат отправки неизвестен. Проверьте канал перед повтором."

#: includes/class-treda-api.php:42
msgid "Could not connect to Telegram."
msgstr "Не удалось связаться с Telegram."

#: includes/class-treda-api.php:64
msgid "Telegram has limited the request rate."
msgstr "Telegram ограничил частоту запросов."

#: includes/class-treda-api.php:74
msgid "Telegram did not confirm the operation result."
msgstr "Telegram не подтвердил результат операции."

#: includes/class-treda-api.php:81
msgid "Telegram rejected the parameters. Check the destination and bot permissions."
msgstr "Telegram отклонил параметры. Проверьте канал и права бота."

#: includes/class-treda-api.php:82
msgid "Telegram rejected the bot token."
msgstr "Telegram отклонил токен бота."

#: includes/class-treda-api.php:83
msgid "The bot does not have access or permission to send messages."
msgstr "У бота нет доступа к чату или права отправлять сообщения."

#: includes/class-treda-api.php:85
msgid "Telegram rejected the request."
msgstr "Telegram отклонил запрос."

#. translators: 1: connection check step, 2: safe Telegram error message.
#: includes/class-treda-api.php:92
msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

#. translators: %s: Telegram bot username, without the @ prefix.
#: includes/class-treda-api.php:98
msgid "Bot: @%s."
msgstr "Бот: @%s."

#: includes/class-treda-api.php:107
msgid "Bot token check"
msgstr "Проверка токена бота"

#: includes/class-treda-api.php:111
msgid "Save the channel before checking the connection."
msgstr "Сохраните канал перед проверкой."

#: includes/class-treda-api.php:115
msgid "Channel access"
msgstr "Доступ к каналу"

#: includes/class-treda-api.php:118
msgid "Select a Telegram channel. Forum groups are not supported by this release."
msgstr "Выберите канал Telegram. Группы с темами в этой версии не поддерживаются."

#: includes/class-treda-api.php:128
msgid "Channel permissions"
msgstr "Права в канале"

#: includes/class-treda-api.php:131
msgid "Add the bot as a channel administrator with permission to publish."
msgstr "Назначьте бота администратором канала с правом публикации."

#: includes/class-treda-api.php:144
msgid "Link a discussion group to the channel before enabling comment synchronization."
msgstr "Перед включением синхронизации комментариев привяжите к каналу группу обсуждений."

#: includes/class-treda-api.php:154
msgid "Discussion group access"
msgstr "Доступ к группе обсуждений"

#: includes/class-treda-api.php:157
msgid "Add the bot as an administrator of the linked discussion group."
msgstr "Назначьте бота администратором связанной группы обсуждений."

#: includes/class-treda-api.php:166 includes/class-treda-api.php:211
msgid "Check the connection first."
msgstr "Сначала проверьте подключение."

#: includes/class-treda-api.php:170
msgid "The webhook requires a public HTTPS URL."
msgstr "Для вебхука нужен публичный HTTPS-адрес."

#: includes/class-treda-api.php:177
msgid "This bot already uses a different webhook. Use a dedicated bot or disconnect the previous integration first."
msgstr "У бота уже настроен другой вебхук. Используйте отдельного бота или сначала отключите прежнюю интеграцию."

#: includes/class-treda-api.php:203
msgid "The bot uses a different webhook. ThreadTandem will not change it."
msgstr "Бот использует другой вебхук. ThreadTandem не будет его менять."

#: includes/class-treda-api.php:219 includes/class-treda-webhook.php:40
msgid "Invalid Telegram update."
msgstr "Получено некорректное событие Telegram."

#: includes/class-treda-api.php:228 includes/class-treda-webhook.php:49
#: includes/class-treda-webhook.php:86
msgid "Could not store the Telegram update."
msgstr "Не удалось сохранить событие."

#: includes/class-treda-bulk.php:50 includes/class-treda-sync.php:232
#: includes/class-treda-webhook.php:26
msgid "Access denied."
msgstr "Доступ запрещён."

#: includes/class-treda-bulk.php:79
msgid "Confirm bulk sending"
msgstr "Подтверждение массовой отправки"

#: includes/class-treda-bulk.php:82
msgid "Posts selected"
msgstr "Выбрано записей"

#: includes/class-treda-bulk.php:82
msgid "Confirm to add these posts to the background queue. New announcements will appear in the channel; linked announcements will be updated. Posts created after this preview are not included. Eligibility is checked again before queuing."
msgstr "После подтверждения записи будут добавлены в очередь. Новые анонсы появятся в канале, уже связанные анонсы будут обновлены. Записи, созданные после открытия этого экрана, не включаются. Перед добавлением в очередь доступность записей проверяется повторно."

#: includes/class-treda-bulk.php:84
msgid "The confirmation expired or the connection changed. Open bulk sending again."
msgstr "Срок подтверждения истёк или подключение изменилось. Откройте массовую отправку заново."

#: includes/class-treda-bulk.php:86
msgid "Cancel"
msgstr "Отмена"

#: includes/class-treda-bulk.php:87
msgid "Confirm and add to queue"
msgstr "Подтвердить и добавить в очередь"

#: includes/class-treda-bulk.php:96
msgid "Bulk sending was queued. Progress is available in Queue and diagnostics."
msgstr "Массовая отправка добавлена в очередь. Состояние доступно в разделе «Очередь и диагностика»."

#: includes/class-treda-bulk.php:96
msgid "Bulk sending was not started. Check the connection and available posts, then confirm again."
msgstr "Массовая отправка не запущена. Проверьте подключение и наличие подходящих записей, затем подтвердите заново."

#: includes/class-treda-bulk.php:98
msgid "Bulk sending"
msgstr "Массовая отправка"

#: includes/class-treda-bulk.php:98
msgid "Send the published archive to your channel"
msgstr "Отправить опубликованные записи сайта в канал"

#: includes/class-treda-bulk.php:98
msgid "Includes all public published posts, regardless of the current search or page. Drafts, password-protected, ignored posts and posts with synchronization disabled are skipped. Linked announcements are updated."
